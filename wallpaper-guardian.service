[Unit]
Description=Wallpaper Guardian v2 - Protección contra wallpapers que crashean Plasma
After=plasma-plasmashell.service
Wants=plasma-plasmashell.service

[Service]
Type=simple
ExecStart=%h/.local/bin/wallpaper-guardian daemon
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=plasma-plasmashell.service
